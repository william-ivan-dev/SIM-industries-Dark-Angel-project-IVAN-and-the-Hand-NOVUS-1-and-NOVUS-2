gridStatus.style.color = '#7ce38b';
logMsg('4-STAGE SEQUENTIAL RESTART COMPLETE. AEGIS-NET NOMINAL.');
}
}
function animate() {
requestAnimationFrame(animate);
controls.update();
habitRing.rotation.x += 0.015;
handAntennaCrossbar.rotation.y += 0.025;
massiveLaserBody.material.emissive.setHex(ivanCombatMode ? 0x0ea5e9 : 0x0c4a6e);
ivanWings.forEach(w => {
const cfg = w.userData;
const targetX = ivanCombatMode ? cfg.openX : cfg.closedX;
const targetZ = ivanCombatMode ? cfg.openZ : cfg.closedZ;
const targetY = ivanCombatMode ? cfg.openY : cfg.closedY;
const targetRotX = Math.PI + (ivanCombatMode ? cfg.openTiltX : cfg.closedTiltX);
const targetRotZ = ivanCombatMode ? cfg.openTiltZ : cfg.closedTiltZ;
w.position.x += (targetX - w.position.x) * 0.04;
w.position.z += (targetZ - w.position.z) * 0.04;
w.position.y += (targetY - w.position.y) * 0.04;
w.rotation.x += (targetRotX - w.rotation.x) * 0.04;
w.rotation.z += (targetRotZ - w.rotation.z) * 0.04;
});
const targetWallZ = superBayMode ? 33 : 15.5;
const targetWallScaleZ = superBayMode ? 0.08 : 1.0;
retractableWalls.forEach(w => {
w.left.position.z += (targetWallZ - w.left.position.z) * 0.08;
w.right.position.z += (-targetWallZ - w.right.position.z) * 0.08;
w.left.scale.z += (targetWallScaleZ - w.left.scale.z) * 0.08;
w.right.scale.z += (targetWallScaleZ - w.right.scale.z) * 0.08;
});
const targetIvanX = superBayMode ? 0 : 95;
const targetIvanScale = superBayMode ? 1.85 : 1.0;
ivanGroup.position.x += (targetIvanX - ivanGroup.position.x) * 0.06;
ivanGroup.scale.set(
ivanGroup.scale.x + (targetIvanScale - ivanGroup.scale.x) * 0.06,
ivanGroup.scale.y + (targetIvanScale - ivanGroup.scale.y) * 0.06,
ivanGroup.scale.z + (targetIvanScale - ivanGroup.scale.z) * 0.06
);
handGroup.visible = !superBayMode;
bay3Sats.forEach(s => { s.visible = !superBayMode; });
if (laserTimer > 0) {
laserTimer -= 0.018;
ivanLaserBeam.material.opacity = laserTimer * 0.92;
if (laserTimer <= 0) {
document.getElementById('val-ivan').textContent = ivanCombatMode ? 'COMBAT (4 BIG STRAIGHT WINGS)' : 'ASTEROID (4 BIG WINGS CLOSED)';
}
} else {
ivanLaserBeam.material.opacity = 0;
}
if (handLaserTimer > 0) {
handLaserTimer -= 0.018;
handLaserBeam.material.opacity = handLaserTimer * 0.92;
if (handLaserTimer <= 0) {
document.getElementById('val-hand').textContent = 'TOP ANTENNA + UNIFIED DISH';
}
} else {
handLaserBeam.material.opacity = 0;
}
const targetDoor = doorsOpen ? Math.PI * 0.45 : 0;
const targetArmY = doorsOpen ? -28 : (superBayMode ? -6 : -12);
bellyDoors.forEach(d => {
d.left.rotation.x += (targetDoor - d.left.rotation.x) * 0.08;
d.right.rotation.x += (-targetDoor - d.right.rotation.x) * 0.08;
});
captureArms.forEach(a => {
a.left.position.y += (targetArmY - a.left.position.y) * 0.08;
a.right.position.y += (targetArmY - a.right.position.y) * 0.08;
const targetArmRotX = superBayMode ? 0.55 : 0;
a.left.rotation.x += (targetArmRotX - a.left.rotation.x) * 0.08;
a.right.rotation.x += (-targetArmRotX - a.right.rotation.x) * 0.08;
});
const targetFleetY = shipsDeployed ? -68 : 0;
fleetGroup.position.y += (targetFleetY - fleetGroup.position.y) * 0.05;
remoraMeshes.forEach((r, idx) => {
r.userData.angle += r.userData.speed;
if (sosActive) {
const orbitR = 22 + (idx % 3) * 6;
r.position.set(
sosSat.position.x + Math.cos(r.userData.angle * 3) * orbitR,
sosSat.position.y + Math.sin(r.userData.angle * 4) * 14,
sosSat.position.z + Math.sin(r.userData.angle * 3) * orbitR
);
} else if (ventClearing) {
const target = ventTargets[r.userData.ventIdx];
const hover = new THREE.Vector3(
target.x + Math.cos(r.userData.angle * 4) * 9,
target.y + Math.sin(r.userData.angle * 5) * 6,
target.z + Math.sin(r.userData.angle * 4) * 9
);
r.position.lerp(hover, 0.08);
} else if (superBayMode) {
const refitHover = new THREE.Vector3(
Math.cos(r.userData.angle * 2 + idx) * 48,
-2 + Math.sin(r.userData.angle * 3) * 10,
Math.sin(r.userData.angle * 2 + idx) * 18
);
r.position.lerp(refitHover, 0.08);
} else {
const patrolPos = new THREE.Vector3(
Math.cos(r.userData.angle) * r.userData.radius * 1.65,
r.userData.yOff + Math.sin(r.userData.angle * 3) * 6,
Math.sin(r.userData.angle) * r.userData.radius * 0.85
);
r.position.lerp(patrolPos, 0.12);
}
});
if (sosActive) {
sosTimer += 0.01;
sosSat.position.lerp(new THREE.Vector3(95, -46, 0), 0.015);
const spinDamp = Math.max(0.005, 0.08 - sosTimer * 0.03);
sosSat.rotation.x += spinDamp;
sosSat.rotation.z += spinDamp;
commanderMeshes.forEach((c) => {
c.userData.angle += 0.03;
const r = c.userData.isScuttler ? 28 : 38;
c.position.set(
sosSat.position.x + Math.cos(c.userData.angle) * r,
sosSat.position.y + (c.userData.isScuttler ? 8 : -8),
sosSat.position.z + Math.sin(c.userData.angle) * r
);
});
}
sternPlume.material.opacity = 0;
bowPlume.material.opacity = 0;
ventralPlume.material.opacity = 0;
if (pulseTimer > 0) {
pulseTimer -= 0.022;
if (activePulse === 'stern') sternPlume.material.opacity = pulseTimer * 0.85;
if (activePulse === 'bow') bowPlume.material.opacity = pulseTimer * 0.85;
if (activePulse === 'ventral') ventralPlume.material.opacity = pulseTimer * 0.85;
darkAngel.position.x = Math.sin(pulseTimer * 20) * 1.4;
if (pulseTimer <= 0) {
document.getElementById('val-pulse').textContent = '24 READY (12S / 8B / 4V)';
}
} else {
darkAngel.position.x *= 0.9;
}
if (canisterProgress >= 0) {
canisterProgress += 0.015;
supplyCanister.position.lerpVectors(moonMesh.position, new THREE.Vector3(-95, -18, 0), canisterProgress);
if (canisterProgress >= 1) {
canisterProgress = -1;
supplyCanister.visible = false;
logMsg('MASS DRIVER PAYLOAD CAPTURED. QUANTUM SIGNATURE VERIFIED.');
}
}
renderer.render(scene, camera);
}
animate();
window.addEventListener('resize', () => {
camera.aspect = window.innerWidth / window.innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(window.innerWidth, window.innerHeight);
});
